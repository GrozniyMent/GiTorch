{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "Orchestrator": {
    "AppId": "",
    "PrivateKeyPathOrPem": "/app/private-key.pem",
    "WebhookSecret": "",
    "RequiredLabel": "self-hosted",
    "RunnerGroupId": 1,
    "DockerSocket": "unix:///var/run/docker.sock",
    "RunnerImage": "ghcr.io/owner/repo/gh-runner:latest",
    "MaxConcurrentRunners": 4,
    "MountDockerSocket": false,
    "UseDinDSidecar": false,
    "DinDImage": "docker:27-dind",
    "RunnerNetworkName": "gitorch-runners",
    "PidsLimit": 512,
    "MemoryLimitMb": 4096,
    "CpuLimitCores": 2.0,
    "JobTimeoutMinutes": 60,
    "DatabasePath": "data/gitorch.db",
    "DatabaseProvider": "Sqlite",
    "PostgresConnectionString": "",
    "RedisConnectionString": "",
    "DeliveryRetentionDays": 7,
    "SessionRetentionDays": 30,
    "RetentionCleanupIntervalMinutes": 60,
    "ShutdownTimeoutSeconds": 30,
    "DockerNodes": [],
    "DashboardUsername": "admin",
    "DashboardPassword": "",
    "RegistryServer": "",
    "RegistryUsername": "",
    "RegistryPassword": "",
    "EnableRepoCache": false,
    "CacheMountPath": "/runner-cache",
    "CacheVolumePrefix": "gitorch-cache",
    "Profiles": []
  }
}
