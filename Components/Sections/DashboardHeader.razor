@namespace RunnerOrchestrator.Components.Sections
@using RunnerOrchestrator.Components.Support

<header class="relative border-b border-zinc-200 dark:border-zinc-800/80 bg-white/80 dark:bg-[#0a0a0b]/80 backdrop-blur">
    <div class="mx-auto flex max-w-[1440px] flex-wrap items-center gap-4 px-5 py-3.5 sm:px-8">
        <div class="flex items-center gap-3">
            <GiTorchLogo Class="h-9 w-9 shrink-0" />
            <span class="font-brand text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100" translate="no">
                Gi<span class="text-orange-600 dark:text-orange-400">Torch</span>
            </span>
        </div>

        <span class="hidden h-5 w-px bg-zinc-200 dark:bg-zinc-800 sm:block" aria-hidden="true"></span>

        <div class="flex min-w-0 flex-1 items-center gap-2.5">
            <span class="max-w-[18rem] truncate rounded-md border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900/70 px-2.5 py-1 font-mono text-xs text-zinc-600 dark:text-zinc-400 sm:max-w-sm"
                  translate="no"
                  title="@RunnerImage">
                @RunnerImage
            </span>
            <span role="status"
                  class="inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[11px] font-semibold tracking-wider @DashboardFormatting.GetImageBadgeClass(ImageStatus)">
                <span class="h-1.5 w-1.5 rounded-full bg-current @(IsImagePulling ? "animate-pulse" : "")" aria-hidden="true"></span>
                @ImageStatus
            </span>
        </div>

        <div class="flex items-center gap-2.5">
            <button type="button"
                    @onclick="OnCycleTheme"
                    title="Theme: @ThemeMode (click to switch)"
                    aria-label="Switch color theme (current: @ThemeMode)"
                    class="inline-flex items-center gap-1.5 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 px-3 py-2 font-mono text-xs uppercase tracking-wider text-zinc-600 dark:text-zinc-400 transition hover:border-zinc-300 dark:hover:border-zinc-700 hover:text-zinc-900 dark:hover:text-zinc-200">
                @if (ThemeMode == "light")
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2m-7.07-15.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
                    </svg>
                }
                else if (ThemeMode == "dark")
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
                    </svg>
                }
                else
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <rect x="2" y="3" width="20" height="14" rx="2" />
                        <path d="M8 21h8M12 17v4" />
                    </svg>
                }
                <span class="hidden sm:inline">@ThemeMode</span>
            </button>

            <button type="button"
                    disabled="@IsPullDisabled"
                    @onclick="OnPullImage"
                    class="inline-flex items-center gap-2 rounded-md border border-zinc-900 dark:border-zinc-700 bg-zinc-900 dark:bg-zinc-100 px-3.5 py-2 font-mono text-xs font-semibold uppercase tracking-wider text-white dark:text-zinc-900 transition hover:bg-zinc-800 dark:hover:bg-white disabled:cursor-not-allowed disabled:border-zinc-200 dark:disabled:border-zinc-800 disabled:bg-zinc-100 dark:disabled:bg-zinc-900 disabled:text-zinc-400 dark:disabled:text-zinc-500">
                @if (IsPullDisabled)
                {
                    <svg class="animate-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path d="M21 12a9 9 0 1 1-6.2-8.56" stroke-linecap="round" />
                    </svg>
                    <span>Pulling…</span>
                }
                else
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3v12" />
                        <path d="m7 10 5 5 5-5" />
                        <path d="M5 21h14" />
                    </svg>
                    <span>Pull image</span>
                }
            </button>

            @if (AuthEnabled)
            {
                <form method="post" action="/logout" class="inline">
                    <button type="submit"
                            title="Sign out"
                            aria-label="Sign out"
                            class="inline-flex items-center gap-1.5 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 px-2.5 py-2 font-mono text-xs text-zinc-600 dark:text-zinc-400 transition hover:border-rose-500/40 hover:text-rose-600 dark:hover:text-rose-400">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                        <span class="hidden md:inline">Sign out</span>
                    </button>
                </form>
            }
        </div>
    </div>
</header>

@code {
    [Parameter, EditorRequired] public string RunnerImage { get; set; } = "";
    [Parameter, EditorRequired] public string ImageStatus { get; set; } = "";
    [Parameter] public bool IsPulling { get; set; }
    [Parameter] public bool AuthEnabled { get; set; }
    [Parameter] public string ThemeMode { get; set; } = "system";
    [Parameter] public EventCallback OnPullImage { get; set; }
    [Parameter] public EventCallback OnCycleTheme { get; set; }

    private bool IsImagePulling => ImageStatus.Contains("PULLING", StringComparison.OrdinalIgnoreCase);
    private bool IsPullDisabled => IsPulling || IsImagePulling;
}
