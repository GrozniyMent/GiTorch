@namespace RunnerOrchestrator.Components.Sections
@using System.Globalization
@using RunnerOrchestrator.Components.Support

<section aria-label="Cluster metrics" class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    @{
        var maxSlots = Math.Max(1, MaxConcurrentRunners);
        var activeSlots = Math.Clamp(ActiveSlotsCount, 0, maxSlots);
        var slotPct = (activeSlots / (double)maxSlots) * 100.0;
        var queuePct = QueuedCount > 0 ? Math.Min(100, QueuedCount * 25) : 0;
        var totalAvg = AverageSlotWaitSeconds + AverageJobDurationSeconds;
        var waitPct = totalAvg > 0 ? Math.Clamp((AverageSlotWaitSeconds / totalAvg) * 100.0, 2.0, 98.0) : 5.0;
    }

    <div class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950/60 p-5 shadow-xs dark:shadow-none">
        <div class="flex items-center justify-between font-mono text-xs uppercase tracking-wider text-zinc-500">
            <span>Active slots</span>
            <span class="text-zinc-400 dark:text-zinc-600" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="6" rx="1.5" />
                    <rect x="3" y="14" width="18" height="6" rx="1.5" />
                </svg>
            </span>
        </div>
        <div class="mt-2.5 font-mono text-3xl font-semibold tabular-nums text-zinc-900 dark:text-zinc-100">
            @ActiveSlotsCount<span class="text-zinc-400 dark:text-zinc-600"> / @MaxConcurrentRunners</span>
        </div>
        <div class="mt-1 font-mono text-xs text-zinc-500 tabular-nums">
            @AvailableSlots available · @slotPct.ToString("F0", CultureInfo.InvariantCulture)% used
        </div>
        <div class="mt-3.5 flex gap-1.5" aria-hidden="true">
            @for (var i = 0; i < MaxConcurrentRunners; i++)
            {
                <span class="h-1.5 flex-1 rounded-full @(i < ActiveSlotsCount ? "bg-orange-500 dark:bg-orange-400" : "bg-zinc-200 dark:bg-zinc-800")"></span>
            }
        </div>
    </div>

    <div class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950/60 p-5 shadow-xs dark:shadow-none">
        <div class="flex items-center justify-between font-mono text-xs uppercase tracking-wider text-zinc-500">
            <span>Queued jobs</span>
            <span class="text-zinc-400 dark:text-zinc-600" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M4 6h16M4 12h10M4 18h6" />
                </svg>
            </span>
        </div>
        <div class="mt-2.5 font-mono text-3xl font-semibold tabular-nums @(QueuedCount > 0 ? "text-sky-600 dark:text-sky-300" : "text-zinc-900 dark:text-zinc-100")">
            @QueuedCount
        </div>
        <div class="mt-1 font-mono text-xs text-zinc-500 tabular-nums" translate="no">
            Label: <span class="text-orange-600 dark:text-orange-300">@RequiredLabel</span>
        </div>
        <div class="mt-3.5 h-1.5 w-full overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800">
            <div class="h-full rounded-full bg-sky-500 dark:bg-sky-400 @(QueuedCount > 0 ? "bar-live" : "") transition-all"
                 style="width:@(queuePct.ToString(CultureInfo.InvariantCulture))%"></div>
        </div>
    </div>

    <div class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950/60 p-5 shadow-xs dark:shadow-none">
        <div class="flex items-center justify-between font-mono text-xs uppercase tracking-wider text-zinc-500">
            <span>Avg wait / job</span>
            <span class="text-zinc-400 dark:text-zinc-600" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                </svg>
            </span>
        </div>
        <div class="mt-2.5 font-mono text-3xl font-semibold tabular-nums text-zinc-900 dark:text-zinc-100">
            @DashboardFormatting.FormatSeconds(AverageSlotWaitSeconds)<span class="text-zinc-400 dark:text-zinc-600"> / </span>@DashboardFormatting.FormatSeconds(AverageJobDurationSeconds)
        </div>
        <div class="mt-1 font-mono text-xs text-zinc-500 tabular-nums">
            @CpuLimitCores CPU / @MemoryLimitMb MB default
        </div>
        <div class="mt-3.5 flex h-1.5 w-full overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800" title="wait vs. run share">
            <div class="h-full bg-amber-500 dark:bg-amber-400" style="width:@(waitPct.ToString("F1", CultureInfo.InvariantCulture))%"></div>
            <div class="h-full flex-1 bg-emerald-500/80 dark:bg-emerald-500/70"></div>
        </div>
    </div>

    <div class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950/60 p-5 shadow-xs dark:shadow-none">
        <div class="flex items-center justify-between font-mono text-xs uppercase tracking-wider text-zinc-500">
            <span>GitHub API errors</span>
            <span class="text-zinc-400 dark:text-zinc-600" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M12 9v4M12 17h.01" />
                    <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
                </svg>
            </span>
        </div>
        <div class="mt-2.5 font-mono text-3xl font-semibold tabular-nums @(GitHubApiErrors > 0 ? "text-rose-600 dark:text-rose-400" : "text-zinc-900 dark:text-zinc-100")">
            @GitHubApiErrors
        </div>
        <div class="mt-1 font-mono text-xs text-zinc-500 tabular-nums">
            @TotalSessions total in history
        </div>
        <div class="mt-3.5 flex items-center gap-1.5 font-mono text-[11px] @(GitHubApiErrors > 0 ? "text-rose-600 dark:text-rose-400" : "text-emerald-600 dark:text-emerald-400/80")">
            <span class="h-2 w-2 rounded-full bg-current" aria-hidden="true"></span>
            @(GitHubApiErrors > 0 ? "degraded" : "healthy")
        </div>
    </div>
</section>

@code {
    [Parameter] public int ActiveSlotsCount { get; set; }
    [Parameter] public int MaxConcurrentRunners { get; set; }
    [Parameter] public int AvailableSlots { get; set; }
    [Parameter] public int QueuedCount { get; set; }
    [Parameter] public string RequiredLabel { get; set; } = "";
    [Parameter] public double AverageSlotWaitSeconds { get; set; }
    [Parameter] public double AverageJobDurationSeconds { get; set; }
    [Parameter] public double CpuLimitCores { get; set; }
    [Parameter] public long MemoryLimitMb { get; set; }
    [Parameter] public long GitHubApiErrors { get; set; }
    [Parameter] public int TotalSessions { get; set; }
}
