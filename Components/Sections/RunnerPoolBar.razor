@namespace RunnerOrchestrator.Components.Sections
@using System.Globalization
@using gitorch.Configuration
@using gitorch.Services.Docker
@using RunnerOrchestrator.Components.Support

@if (Nodes.Count > 1 || Profiles.Count > 0)
{
    <section aria-label="Runner pool and profiles" class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950/60 shadow-xs dark:shadow-none">
        <div class="flex flex-col gap-3 px-4 py-3 lg:flex-row lg:items-center">
            <div class="flex min-w-0 flex-1 items-center gap-3">
                <span class="shrink-0 font-mono text-[11px] uppercase tracking-wider text-zinc-500">Nodes</span>
                <ul class="scroll-x flex gap-2 overflow-x-auto">
                    @foreach (var node in Nodes)
                    {
                        var nodePct = Math.Min(100.0, (node.ActiveContainers / (double)Math.Max(1, MaxConcurrentRunners)) * 100.0);
                        <li class="flex min-w-[240px] items-center gap-2.5 rounded-md border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/40 px-3 py-2">
                            <span class="h-2 w-2 shrink-0 rounded-full bg-emerald-500 dark:bg-emerald-400 shadow-[0_0_8px_rgba(16,185,129,.5)] dark:shadow-[0_0_8px_rgba(52,211,153,.7)]" aria-label="healthy"></span>
                            <span class="truncate font-mono text-xs text-zinc-700 dark:text-zinc-300" translate="no" title="@node.Endpoint">
                                @DashboardFormatting.FormatNodeEndpoint(node.Endpoint)
                            </span>
                            <span class="ml-auto flex items-center gap-1.5">
                                <span class="h-1.5 w-12 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800">
                                    <span class="block h-full bg-orange-500 dark:bg-orange-400" style="width:@(nodePct.ToString("F0", CultureInfo.InvariantCulture))%"></span>
                                </span>
                                <span class="font-mono text-[11px] tabular-nums text-zinc-500">@node.ActiveContainers</span>
                            </span>
                        </li>
                    }
                </ul>
            </div>

            @if (Profiles.Count > 0)
            {
                <span class="hidden h-6 w-px bg-zinc-200 dark:bg-zinc-800 lg:block" aria-hidden="true"></span>
                <div class="flex items-center gap-3">
                    <span class="shrink-0 font-mono text-[11px] uppercase tracking-wider text-zinc-500">Profiles</span>
                    <ul class="flex flex-wrap gap-1.5">
                        @foreach (var profile in Profiles)
                        {
                            var labelsText = string.Join(", ", profile.MatchLabels);
                            <li>
                                <span tabindex="0"
                                      class="inline-flex cursor-help items-center gap-1.5 rounded-md border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/40 px-2.5 py-1.5 font-mono text-xs text-zinc-700 dark:text-zinc-300 hover:border-zinc-400 dark:hover:border-zinc-600"
                                      translate="no"
                                      title="matchLabels: @labelsText">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-zinc-400 dark:text-zinc-500" aria-hidden="true">
                                        <path d="M12 2 2 7l10 5 10-5-10-5z" />
                                        <path d="m2 17 10 5 10-5M2 12l10 5 10-5" />
                                    </svg>
                                    @profile.Name
                                    <span class="sr-only">, matches @labelsText</span>
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<DockerNodeStatus> Nodes { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<RunnerProfile> Profiles { get; set; } = [];
    [Parameter] public int MaxConcurrentRunners { get; set; } = 1;
}
