@namespace RunnerOrchestrator.Components.Sections
@using RunnerOrchestrator.Components.Support

<div class="fixed bottom-4 right-4 z-50 flex w-80 flex-col gap-2" aria-live="polite" aria-atomic="false">
    @foreach (var toast in Toasts)
    {
        <div role="@(toast.Kind == "error" ? "alert" : "status")"
             class="toast-in flex items-start gap-2.5 rounded-lg border @DashboardFormatting.GetToastBorderClass(toast.Kind) bg-white/95 dark:bg-zinc-950/95 px-3 py-2.5 shadow-xl backdrop-blur">
            <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full @DashboardFormatting.GetToastDotClass(toast.Kind)" aria-hidden="true"></span>
            <p class="flex-1 font-mono text-[11px] leading-relaxed text-zinc-800 dark:text-zinc-200">@toast.Message</p>
            <button type="button"
                    aria-label="Dismiss notification"
                    @onclick="() => OnDismiss.InvokeAsync(toast.Id)"
                    class="rounded p-0.5 text-zinc-400 dark:text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                    <path d="M18 6 6 18M6 6l12 12" />
                </svg>
            </button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ToastMessage> Toasts { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnDismiss { get; set; }
}
